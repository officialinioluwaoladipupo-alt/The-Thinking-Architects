rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny everything not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'oladipupoinioluwa93@gmail.com',
          'officialinioluwaoladipupo@gmail.com'
        ];
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidBoundedStrings(arr) {
      return arr is list
        && arr.size() >= 1
        && arr.size() <= 6
        && arr[0] is string
        && arr[0].size() >= 1
        && arr[0].size() <= 160;
    }

    function isValidResourceItem(item) {
      return item is map
        && item.keys().hasAll(['label', 'url'])
        && item.keys().hasOnly(['label', 'url'])
        && item.label is string && item.label.size() >= 1 && item.label.size() <= 80
        && item.url is string && item.url.size() >= 10 && item.url.size() <= 350 && item.url.matches('^https://.*');
    }

    function isValidResourceList(arr) {
      return arr is list
        && arr.size() <= 4
        && (arr.size() < 1 || isValidResourceItem(arr[0]))
        && (arr.size() < 2 || isValidResourceItem(arr[1]))
        && (arr.size() < 3 || isValidResourceItem(arr[2]))
        && (arr.size() < 4 || isValidResourceItem(arr[3]));
    }

    function isValidWrappedRequiredList(arr, maxItems, maxLen) {
      return arr is list
        && arr.size() >= 1
        && arr.size() <= maxItems
        && arr[0] is string
        && arr[0].size() >= 1
        && arr[0].size() <= maxLen;
    }

    function isValidWrappedOptionalList(arr, maxItems, maxLen) {
      return arr is list
        && arr.size() <= maxItems
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= maxLen));
    }

    function isValidCount(val) {
      return val is int && val >= 0 && val <= 10000000;
    }

    // --- Validation Blueprints (Anti-Update-Gap) ---
    function isValidSession(data) {
      return data.keys().hasAll([
          'number', 'title', 'speaker', 'speakerRole', 'dateLabel', 'timeLabel',
          'format', 'status', 'isNextSession', 'published', 'summary', 'topics',
          'registrationUrl', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'number', 'title', 'speaker', 'speakerRole', 'dateLabel', 'timeLabel',
          'format', 'status', 'isNextSession', 'published', 'summary', 'topics',
          'registrationUrl', 'startAtIso', 'resources', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.number is string && data.number.size() >= 2 && data.number.size() <= 40
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 140
        && data.speaker is string && data.speaker.size() >= 2 && data.speaker.size() <= 100
        && data.speakerRole is string && data.speakerRole.size() >= 2 && data.speakerRole.size() <= 120
        && data.dateLabel is string && data.dateLabel.size() >= 2 && data.dateLabel.size() <= 80
        && data.timeLabel is string && data.timeLabel.size() >= 2 && data.timeLabel.size() <= 80
        && data.format is string && data.format.size() >= 2 && data.format.size() <= 80
        && data.status is string && data.status in ['upcoming', 'archived']
        && data.isNextSession is bool
        && data.published is bool
        && data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 600
        && isValidBoundedStrings(data.topics)
        && data.registrationUrl is string && data.registrationUrl.size() <= 300 && data.registrationUrl.matches('^(https://.*)?$')
        && (!('startAtIso' in data) || (
          data.startAtIso is string
          && data.startAtIso.size() <= 40
          && (data.startAtIso == '' || data.startAtIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[-+][0-9]{2}:[0-9]{2})$'))
        ))
        && (!('resources' in data) || isValidResourceList(data.resources))
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMedia(data) {
      return data.keys().hasAll([
          'kind', 'sessionRef', 'title', 'speaker', 'duration', 'publishedAt',
          'mediaUrl', 'published', 'summary', 'highlights', 'createdBy',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'kind', 'sessionRef', 'title', 'speaker', 'duration', 'publishedAt',
          'mediaUrl', 'published', 'summary', 'highlights', 'createdBy',
          'createdAt', 'updatedAt'
        ])
        && data.kind is string && data.kind in ['Recording', 'Feature']
        && data.sessionRef is string && data.sessionRef.size() >= 2 && data.sessionRef.size() <= 60
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 140
        && data.speaker is string && data.speaker.size() >= 2 && data.speaker.size() <= 100
        && data.duration is string && data.duration.size() >= 2 && data.duration.size() <= 40
        && data.publishedAt is string && data.publishedAt.size() >= 2 && data.publishedAt.size() <= 60
        && data.mediaUrl is string && data.mediaUrl.size() <= 400 && data.mediaUrl.matches('^(https://.*)?$')
        && data.published is bool
        && data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 600
        && isValidBoundedStrings(data.highlights)
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'displayName', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['email', 'displayName', 'addedBy', 'createdAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 254 && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['email', 'name', 'stage', 'question', 'source', 'createdAt'])
        && data.keys().hasOnly(['email', 'name', 'stage', 'question', 'source', 'createdAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 254 && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.name is string && data.name.size() <= 100
        && data.stage is string && data.stage.size() <= 80
        && data.question is string && data.question.size() <= 300
        && data.source is string && data.source in ['footer', 'join_modal']
        && data.createdAt is timestamp;
    }

    function isValidPitch(data) {
      return data.keys().hasAll([
          'pitchType', 'name', 'email', 'roleOrStudio', 'topicTitle',
          'targetStage', 'outline', 'linkUrl', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'pitchType', 'name', 'email', 'roleOrStudio', 'topicTitle',
          'targetStage', 'outline', 'linkUrl', 'status', 'createdAt', 'updatedAt'
        ])
        && data.pitchType is string && data.pitchType in ['speaker', 'topic']
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 254 && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.roleOrStudio is string && data.roleOrStudio.size() <= 120
        && data.topicTitle is string && data.topicTitle.size() >= 3 && data.topicTitle.size() <= 140
        && data.targetStage is string && data.targetStage in ['Students', 'Graduates & Early-Career', 'Practising Architects', 'All Stages']
        && data.outline is string && data.outline.size() >= 10 && data.outline.size() <= 800
        && data.linkUrl is string && data.linkUrl.size() <= 300 && data.linkUrl.matches('^(https://.*)?$')
        && data.status is string && data.status in ['new', 'reviewed', 'scheduled', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll(['instagramUrl', 'xUrl', 'linkedinUrl', 'youtubeUrl', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['instagramUrl', 'xUrl', 'linkedinUrl', 'youtubeUrl', 'updatedBy', 'updatedAt'])
        && data.instagramUrl is string && data.instagramUrl.size() <= 300 && data.instagramUrl.matches('^(https://.*)?$')
        && data.xUrl is string && data.xUrl.size() <= 300 && data.xUrl.matches('^(https://.*)?$')
        && data.linkedinUrl is string && data.linkedinUrl.size() <= 300 && data.linkedinUrl.matches('^(https://.*)?$')
        && data.youtubeUrl is string && data.youtubeUrl.size() <= 300 && data.youtubeUrl.matches('^(https://.*)?$')
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidWrappedKeys(data) {
      return data.keys().size() == 51
        && data.keys().hasAll([
          'enabled', 'showInFooter', 'showInNav', 'homeBannerEnabled', 'homeCountdownEnabled',
          'yearLabel', 'eyebrow', 'pageTitle', 'pageSubtitle', 'shareCaption',
          'offlineTitle', 'offlineMessage', 'homeBannerEyebrow', 'homeBannerTitle',
          'homeBannerCtaLabel', 'launchDateIso', 'coverTitle', 'coverSubtitle',
          'startLead', 'startStatement', 'audienceCount', 'audiencePrefix',
          'audienceSuffix', 'audienceCaption', 'returningCount', 'returningSuffix',
          'returningCaption', 'sessionsHeading', 'sessionHighlights', 'awarenessDate',
          'awarenessPrefix', 'awarenessProgramTitle', 'awarenessSpeaker',
          'communityTotal', 'communityCaption', 'studentsCount', 'professionalsCount',
          'discoveryHighlight', 'discoveryBody', 'discoveryPercent', 'locationsLead',
          'locationPrimary', 'locationSecondary', 'extraLocations', 'welcomeStatement',
          'thankYouStatement', 'closingStatement', 'closingCtaLabel', 'customStats',
          'updatedBy', 'updatedAt'
        ]);
    }

    function isValidWrappedMeta(data) {
      return data.enabled is bool
        && data.showInFooter is bool
        && data.showInNav is bool
        && data.homeBannerEnabled is bool
        && data.homeCountdownEnabled is bool
        && data.yearLabel is string && data.yearLabel.size() >= 1 && data.yearLabel.size() <= 20
        && data.eyebrow is string && data.eyebrow.size() <= 80
        && data.pageTitle is string && data.pageTitle.size() <= 120
        && data.pageSubtitle is string && data.pageSubtitle.size() <= 240
        && data.shareCaption is string && data.shareCaption.size() <= 420
        && data.offlineTitle is string && data.offlineTitle.size() <= 120
        && data.offlineMessage is string && data.offlineMessage.size() <= 320
        && data.homeBannerEyebrow is string && data.homeBannerEyebrow.size() <= 80
        && data.homeBannerTitle is string && data.homeBannerTitle.size() <= 140
        && data.homeBannerCtaLabel is string && data.homeBannerCtaLabel.size() <= 50
        && data.launchDateIso is string && data.launchDateIso.size() <= 40
        && (data.launchDateIso == '' || data.launchDateIso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[-+][0-9]{2}:[0-9]{2})$'));
    }

    function isValidWrappedNumbers(data) {
      return isValidCount(data.audienceCount)
        && data.audiencePrefix is string && data.audiencePrefix.size() <= 10
        && data.audienceSuffix is string && data.audienceSuffix.size() <= 10
        && data.audienceCaption is string && data.audienceCaption.size() <= 180
        && isValidCount(data.returningCount)
        && data.returningSuffix is string && data.returningSuffix.size() <= 10
        && data.returningCaption is string && data.returningCaption.size() <= 180
        && isValidCount(data.communityTotal)
        && data.communityCaption is string && data.communityCaption.size() <= 160
        && isValidCount(data.studentsCount)
        && isValidCount(data.professionalsCount)
        && data.discoveryPercent is int && data.discoveryPercent >= 1 && data.discoveryPercent <= 100;
    }

    function isValidWrappedCopyAndLists(data) {
      return data.coverTitle is string && data.coverTitle.size() <= 120
        && data.coverSubtitle is string && data.coverSubtitle.size() <= 180
        && data.startLead is string && data.startLead.size() <= 140
        && data.startStatement is string && data.startStatement.size() <= 200
        && data.sessionsHeading is string && data.sessionsHeading.size() <= 160
        && isValidWrappedRequiredList(data.sessionHighlights, 8, 220)
        && data.awarenessDate is string && data.awarenessDate.size() <= 40
        && data.awarenessPrefix is string && data.awarenessPrefix.size() <= 180
        && data.awarenessProgramTitle is string && data.awarenessProgramTitle.size() <= 120
        && data.awarenessSpeaker is string && data.awarenessSpeaker.size() <= 140
        && data.discoveryHighlight is string && data.discoveryHighlight.size() <= 80
        && data.discoveryBody is string && data.discoveryBody.size() <= 200
        && data.locationsLead is string && data.locationsLead.size() <= 140
        && data.locationPrimary is string && data.locationPrimary.size() <= 60
        && data.locationSecondary is string && data.locationSecondary.size() <= 60
        && isValidWrappedOptionalList(data.extraLocations, 10, 60)
        && data.welcomeStatement is string && data.welcomeStatement.size() <= 260
        && data.thankYouStatement is string && data.thankYouStatement.size() <= 260
        && data.closingStatement is string && data.closingStatement.size() <= 220
        && data.closingCtaLabel is string && data.closingCtaLabel.size() <= 60
        && isValidWrappedOptionalList(data.customStats, 6, 220)
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidWrappedConfig(data) {
      return isValidWrappedKeys(data)
        && isValidWrappedMeta(data)
        && isValidWrappedNumbers(data)
        && isValidWrappedCopyAndLists(data);
    }

    function isAllowedWrappedConfigId(configId) {
      return configId == 'public' || configId.matches('^year-[0-9]{4}$');
    }

    // --- Collection: Think Sessions (/sessions/{sessionId}) ---
    match /sessions/{sessionId} {
      allow get: if isValidId(sessionId) && ((resource != null && existing().published == true) || isAdmin());
      allow list: if resource.data.published == true || isAdmin();

      allow create: if isAdmin()
        && isValidId(sessionId)
        && isValidSession(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(sessionId)
        && isValidSession(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'number', 'title', 'speaker', 'speakerRole', 'dateLabel', 'timeLabel',
            'format', 'status', 'isNextSession', 'published', 'summary', 'topics',
            'registrationUrl', 'startAtIso', 'resources', 'updatedAt'
          ])
          ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'published', 'isNextSession', 'status', 'updatedAt'
          ])
        );

      allow delete: if isAdmin() && isValidId(sessionId);
    }

    // --- Collection: Media & Recordings (/media/{mediaId}) ---
    match /media/{mediaId} {
      allow get: if isValidId(mediaId) && ((resource != null && existing().published == true) || isAdmin());
      allow list: if resource.data.published == true || isAdmin();

      allow create: if isAdmin()
        && isValidId(mediaId)
        && isValidMedia(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(mediaId)
        && isValidMedia(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'kind', 'sessionRef', 'title', 'speaker', 'duration', 'publishedAt',
            'mediaUrl', 'published', 'summary', 'highlights', 'updatedAt'
          ])
          ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'published', 'updatedAt'
          ])
        );

      allow delete: if isAdmin() && isValidId(mediaId);
    }

    // --- Collection: Admin Registry (/admins/{userId}) ---
    match /admins/{userId} {
      allow get: if isAdmin() && isValidId(userId);
      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidId(userId)
        && isValidAdmin(incoming())
        && incoming().addedBy == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if isAdmin()
        && isValidId(userId)
        && isValidAdmin(incoming())
        && incoming().addedBy == existing().addedBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName']);

      allow delete: if isAdmin()
        && isValidId(userId)
        && userId != request.auth.uid;
    }

    // --- Collection: Community Subscribers (/subscribers/{subscriberId}) ---
    match /subscribers/{subscriberId} {
      allow get, list: if isAdmin();

      allow create: if isValidId(subscriberId)
        && isValidSubscriber(incoming())
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin() && isValidId(subscriberId);
    }

    // --- Collection: Speaker & Topic Pitches (/pitches/{pitchId}) ---
    match /pitches/{pitchId} {
      allow get, list: if isAdmin();

      allow create: if isValidId(pitchId)
        && isValidPitch(incoming())
        && incoming().status == 'new'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(pitchId)
        && isValidPitch(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(pitchId);
    }

    // --- Collection: Public Site Channel Settings (/siteSettings/{settingId}) ---
    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'public';
      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidId(settingId)
        && settingId == 'public'
        && isValidSiteSettings(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(settingId)
        && settingId == 'public'
        && isValidSiteSettings(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).addedKeys().hasOnly([
          'instagramUrl', 'xUrl', 'linkedinUrl', 'youtubeUrl', 'updatedBy', 'updatedAt'
        ])
        && incoming().diff(existing()).changedKeys().hasOnly([
          'instagramUrl', 'xUrl', 'linkedinUrl', 'youtubeUrl', 'updatedBy', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // --- Collection: Public Wrapped CMS Configuration & Yearly Archives (/wrappedConfig/{configId}) ---
    match /wrappedConfig/{configId} {
      allow get: if isValidId(configId) && (
        configId == 'public' ||
        (configId.matches('^year-[0-9]{4}$') && ((resource != null && existing().enabled == true) || isAdmin()))
      );
      allow list: if resource.data.enabled == true || isAdmin();

      allow create: if isAdmin()
        && isValidId(configId)
        && isAllowedWrappedConfigId(configId)
        && isValidWrappedConfig(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(configId)
        && isAllowedWrappedConfigId(configId)
        && isValidWrappedConfig(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'enabled', 'showInFooter', 'showInNav', 'homeBannerEnabled', 'homeCountdownEnabled',
          'yearLabel', 'eyebrow', 'pageTitle', 'pageSubtitle', 'shareCaption',
          'offlineTitle', 'offlineMessage', 'homeBannerEyebrow', 'homeBannerTitle',
          'homeBannerCtaLabel', 'launchDateIso', 'coverTitle', 'coverSubtitle',
          'startLead', 'startStatement', 'audienceCount', 'audiencePrefix',
          'audienceSuffix', 'audienceCaption', 'returningCount', 'returningSuffix',
          'returningCaption', 'sessionsHeading', 'sessionHighlights', 'awarenessDate',
          'awarenessPrefix', 'awarenessProgramTitle', 'awarenessSpeaker',
          'communityTotal', 'communityCaption', 'studentsCount', 'professionalsCount',
          'discoveryHighlight', 'discoveryBody', 'discoveryPercent', 'locationsLead',
          'locationPrimary', 'locationSecondary', 'extraLocations', 'welcomeStatement',
          'thankYouStatement', 'closingStatement', 'closingCtaLabel', 'customStats',
          'updatedBy', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(configId) && configId.matches('^year-[0-9]{4}$');
    }
  }
}
