rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny everything not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'officialinioluwaoladipupo@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidBoundedStrings(arr) {
      return arr is list
        && arr.size() >= 1
        && arr.size() <= 6
        && arr[0] is string
        && arr[0].size() >= 1
        && arr[0].size() <= 160;
    }

    function isValidWrappedItems(arr) {
      return arr is list
        && arr.size() <= 8
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 220));
    }

    // --- Validation Blueprints (Anti-Update-Gap) ---
    function isValidSession(data) {
      return data.keys().hasAll([
          'number', 'title', 'speaker', 'speakerRole', 'dateLabel', 'timeLabel',
          'format', 'status', 'isNextSession', 'published', 'summary', 'topics',
          'registrationUrl', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'number', 'title', 'speaker', 'speakerRole', 'dateLabel', 'timeLabel',
          'format', 'status', 'isNextSession', 'published', 'summary', 'topics',
          'registrationUrl', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.number is string && data.number.size() >= 2 && data.number.size() <= 40
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 140
        && data.speaker is string && data.speaker.size() >= 2 && data.speaker.size() <= 100
        && data.speakerRole is string && data.speakerRole.size() >= 2 && data.speakerRole.size() <= 120
        && data.dateLabel is string && data.dateLabel.size() >= 2 && data.dateLabel.size() <= 80
        && data.timeLabel is string && data.timeLabel.size() >= 2 && data.timeLabel.size() <= 80
        && data.format is string && data.format.size() >= 2 && data.format.size() <= 80
        && data.status is string && data.status in ['upcoming', 'archived']
        && data.isNextSession is bool
        && data.published is bool
        && data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 600
        && isValidBoundedStrings(data.topics)
        && data.registrationUrl is string && data.registrationUrl.size() <= 300 && data.registrationUrl.matches('^(https://.*)?$')
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMedia(data) {
      return data.keys().hasAll([
          'kind', 'sessionRef', 'title', 'speaker', 'duration', 'publishedAt',
          'mediaUrl', 'published', 'summary', 'highlights', 'createdBy',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'kind', 'sessionRef', 'title', 'speaker', 'duration', 'publishedAt',
          'mediaUrl', 'published', 'summary', 'highlights', 'createdBy',
          'createdAt', 'updatedAt'
        ])
        && data.kind is string && data.kind in ['Recording', 'Feature']
        && data.sessionRef is string && data.sessionRef.size() >= 2 && data.sessionRef.size() <= 60
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 140
        && data.speaker is string && data.speaker.size() >= 2 && data.speaker.size() <= 100
        && data.duration is string && data.duration.size() >= 2 && data.duration.size() <= 40
        && data.publishedAt is string && data.publishedAt.size() >= 2 && data.publishedAt.size() <= 60
        && data.mediaUrl is string && data.mediaUrl.size() <= 400 && data.mediaUrl.matches('^(https://.*)?$')
        && data.published is bool
        && data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 600
        && isValidBoundedStrings(data.highlights)
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'displayName', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['email', 'displayName', 'addedBy', 'createdAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 254 && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['email', 'name', 'stage', 'question', 'source', 'createdAt'])
        && data.keys().hasOnly(['email', 'name', 'stage', 'question', 'source', 'createdAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 254 && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.name is string && data.name.size() <= 100
        && data.stage is string && data.stage.size() <= 80
        && data.question is string && data.question.size() <= 300
        && data.source is string && data.source in ['footer', 'join_modal']
        && data.createdAt is timestamp;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll(['instagramUrl', 'xUrl', 'linkedinUrl', 'youtubeUrl', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['instagramUrl', 'xUrl', 'linkedinUrl', 'youtubeUrl', 'updatedBy', 'updatedAt'])
        && data.instagramUrl is string && data.instagramUrl.size() <= 300 && data.instagramUrl.matches('^(https://.*)?$')
        && data.xUrl is string && data.xUrl.size() <= 300 && data.xUrl.matches('^(https://.*)?$')
        && data.linkedinUrl is string && data.linkedinUrl.size() <= 300 && data.linkedinUrl.matches('^(https://.*)?$')
        && data.youtubeUrl is string && data.youtubeUrl.size() <= 300 && data.youtubeUrl.matches('^(https://.*)?$')
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidWrappedSettings(data) {
      return data.keys().hasAll([
          'enabled', 'showHomeBanner', 'countdownTargetIso', 'countdownHeadline',
          'countdownSubtext', 'pageTitle', 'pageIntro', 'closingHeadline',
          'closingBody', 'shareCaption', 'autoplaySeconds', 'updatedBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'enabled', 'showHomeBanner', 'countdownTargetIso', 'countdownHeadline',
          'countdownSubtext', 'pageTitle', 'pageIntro', 'closingHeadline',
          'closingBody', 'shareCaption', 'autoplaySeconds', 'updatedBy', 'updatedAt'
        ])
        && data.enabled is bool
        && data.showHomeBanner is bool
        && data.countdownTargetIso is string
        && data.countdownTargetIso.size() <= 40
        && data.countdownTargetIso.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?)?$')
        && data.countdownHeadline is string && data.countdownHeadline.size() >= 3 && data.countdownHeadline.size() <= 140
        && data.countdownSubtext is string && data.countdownSubtext.size() >= 5 && data.countdownSubtext.size() <= 260
        && data.pageTitle is string && data.pageTitle.size() >= 3 && data.pageTitle.size() <= 100
        && data.pageIntro is string && data.pageIntro.size() >= 5 && data.pageIntro.size() <= 240
        && data.closingHeadline is string && data.closingHeadline.size() >= 3 && data.closingHeadline.size() <= 120
        && data.closingBody is string && data.closingBody.size() >= 5 && data.closingBody.size() <= 240
        && data.shareCaption is string && data.shareCaption.size() >= 10 && data.shareCaption.size() <= 400
        && data.autoplaySeconds is number && data.autoplaySeconds >= 0 && data.autoplaySeconds <= 60
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidLiveSettings(data) {
      return data.keys().hasAll([
          'isLive', 'liveSessionId', 'liveTitle', 'liveRoomUrl', 'liveStartedAtIso',
          'qaEnabled', 'announcementEnabled', 'announcementText',
          'announcementLinkLabel', 'announcementLinkHref', 'updatedBy', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'isLive', 'liveSessionId', 'liveTitle', 'liveRoomUrl', 'liveStartedAtIso',
          'qaEnabled', 'announcementEnabled', 'announcementText',
          'announcementLinkLabel', 'announcementLinkHref', 'updatedBy', 'updatedAt'
        ])
        && data.isLive is bool
        && data.liveSessionId is string && data.liveSessionId.size() <= 128 && data.liveSessionId.matches('^([a-zA-Z0-9_\\-]+)?$')
        && data.liveTitle is string && data.liveTitle.size() <= 140
        && data.liveRoomUrl is string && data.liveRoomUrl.size() <= 400 && data.liveRoomUrl.matches('^(https://.*)?$')
        && data.liveStartedAtIso is string
        && data.liveStartedAtIso.size() <= 40
        && data.liveStartedAtIso.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?)?$')
        && data.qaEnabled is bool
        && data.announcementEnabled is bool
        && data.announcementText is string && data.announcementText.size() <= 140
        && data.announcementLinkLabel is string && data.announcementLinkLabel.size() <= 40
        && data.announcementLinkHref is string && data.announcementLinkHref.size() <= 300 && data.announcementLinkHref.matches('^((https://.*)|(/.*))?$')
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidSessionQuestion(data) {
      return data.keys().hasAll([
          'sessionId', 'authorName', 'question', 'upvotes', 'answered', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'sessionId', 'authorName', 'question', 'upvotes', 'answered', 'createdAt', 'updatedAt'
        ])
        && data.sessionId is string && isValidId(data.sessionId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60
        && data.question is string && data.question.size() >= 5 && data.question.size() <= 280
        && data.upvotes is number && data.upvotes >= 1 && data.upvotes <= 100000
        && data.answered is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWrappedSlide(data) {
      return data.keys().hasAll([
          'order', 'label', 'kind', 'theme', 'eyebrow', 'headline', 'body',
          'accentDate', 'metricPrefix', 'metricValue', 'metricSuffix',
          'secondaryMetricA', 'secondaryLabelA', 'secondaryMetricB', 'secondaryLabelB',
          'items', 'ctaLabel', 'published', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'order', 'label', 'kind', 'theme', 'eyebrow', 'headline', 'body',
          'accentDate', 'metricPrefix', 'metricValue', 'metricSuffix',
          'secondaryMetricA', 'secondaryLabelA', 'secondaryMetricB', 'secondaryLabelB',
          'items', 'ctaLabel', 'published', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.order is number && data.order >= 0 && data.order <= 1000
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 40
        && data.kind is string && data.kind in ['cover', 'statement', 'metric', 'sessions', 'community', 'cta']
        && data.theme is string && data.theme in ['dark', 'cream']
        && data.eyebrow is string && data.eyebrow.size() <= 100
        && data.headline is string && data.headline.size() <= 240
        && data.body is string && data.body.size() <= 320
        && data.accentDate is string && data.accentDate.size() <= 40
        && data.metricPrefix is string && data.metricPrefix.size() <= 8
        && data.metricValue is number && data.metricValue >= 0 && data.metricValue <= 10000000
        && data.metricSuffix is string && data.metricSuffix.size() <= 16
        && data.secondaryMetricA is number && data.secondaryMetricA >= 0 && data.secondaryMetricA <= 10000000
        && data.secondaryLabelA is string && data.secondaryLabelA.size() <= 60
        && data.secondaryMetricB is number && data.secondaryMetricB >= 0 && data.secondaryMetricB <= 10000000
        && data.secondaryLabelB is string && data.secondaryLabelB.size() <= 60
        && isValidWrappedItems(data.items)
        && data.ctaLabel is string && data.ctaLabel.size() <= 50
        && data.published is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection: Think Sessions (/sessions/{sessionId}) ---
    match /sessions/{sessionId} {
      allow get: if isValidId(sessionId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();

      allow create: if isAdmin()
        && isValidId(sessionId)
        && isValidSession(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(sessionId)
        && isValidSession(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'number', 'title', 'speaker', 'speakerRole', 'dateLabel', 'timeLabel',
            'format', 'status', 'isNextSession', 'published', 'summary', 'topics',
            'registrationUrl', 'updatedAt'
          ])
          ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'published', 'isNextSession', 'status', 'updatedAt'
          ])
        );

      allow delete: if isAdmin() && isValidId(sessionId);
    }

    // --- Collection: Live Q&A Queue (/sessionQuestions/{questionId}) ---
    match /sessionQuestions/{questionId} {
      allow get: if isValidId(questionId);
      allow list: if resource.data.sessionId is string && resource.data.sessionId.size() >= 1;

      allow create: if isValidId(questionId)
        && isValidSessionQuestion(incoming())
        && incoming().upvotes == 1
        && incoming().answered == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          incoming().sessionId == 'live-lobby'
          || exists(/databases/$(database)/documents/sessions/$(incoming().sessionId))
        );

      allow update: if isValidId(questionId)
        && isValidSessionQuestion(incoming())
        && incoming().sessionId == existing().sessionId
        && incoming().authorName == existing().authorName
        && incoming().question == existing().question
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['answered', 'updatedAt'])
          )
          ||
          (
            incoming().answered == existing().answered
            && incoming().upvotes == existing().upvotes + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(questionId);
    }

    // --- Collection: Media & Recordings (/media/{mediaId}) ---
    match /media/{mediaId} {
      allow get: if isValidId(mediaId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();

      allow create: if isAdmin()
        && isValidId(mediaId)
        && isValidMedia(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(mediaId)
        && isValidMedia(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'kind', 'sessionRef', 'title', 'speaker', 'duration', 'publishedAt',
            'mediaUrl', 'published', 'summary', 'highlights', 'updatedAt'
          ])
          ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'published', 'updatedAt'
          ])
        );

      allow delete: if isAdmin() && isValidId(mediaId);
    }

    // --- Collection: Admin Registry (/admins/{userId}) ---
    match /admins/{userId} {
      allow get: if isAdmin() && isValidId(userId);
      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidId(userId)
        && isValidAdmin(incoming())
        && incoming().addedBy == request.auth.uid
        && incoming().createdAt == request.time;

      allow update: if isAdmin()
        && isValidId(userId)
        && isValidAdmin(incoming())
        && incoming().addedBy == existing().addedBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName']);

      allow delete: if isAdmin()
        && isValidId(userId)
        && userId != request.auth.uid;
    }

    // --- Collection: Community Subscribers (/subscribers/{subscriberId}) ---
    match /subscribers/{subscriberId} {
      allow get, list: if isAdmin();

      allow create: if isValidId(subscriberId)
        && isValidSubscriber(incoming())
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin() && isValidId(subscriberId);
    }

    // --- Collection: Public Site, Live & Wrapped Settings (/siteSettings/{settingId}) ---
    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'public' || settingId == 'wrapped' || settingId == 'live');
      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidId(settingId)
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (
          (settingId == 'public' && isValidSiteSettings(incoming()))
          ||
          (settingId == 'wrapped' && isValidWrappedSettings(incoming()))
          ||
          (settingId == 'live' && isValidLiveSettings(incoming()))
        );

      allow update: if isAdmin()
        && isValidId(settingId)
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && (
          (
            settingId == 'public'
            && isValidSiteSettings(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'instagramUrl', 'xUrl', 'linkedinUrl', 'youtubeUrl', 'updatedBy', 'updatedAt'
            ])
          )
          ||
          (
            settingId == 'wrapped'
            && isValidWrappedSettings(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'enabled', 'showHomeBanner', 'countdownTargetIso', 'countdownHeadline',
              'countdownSubtext', 'pageTitle', 'pageIntro', 'closingHeadline',
              'closingBody', 'shareCaption', 'autoplaySeconds', 'updatedBy', 'updatedAt'
            ])
          )
          ||
          (
            settingId == 'live'
            && isValidLiveSettings(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'isLive', 'liveSessionId', 'liveTitle', 'liveRoomUrl', 'liveStartedAtIso',
              'qaEnabled', 'announcementEnabled', 'announcementText',
              'announcementLinkLabel', 'announcementLinkHref', 'updatedBy', 'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    // --- Collection: Year Wrapped Slides (/wrappedSlides/{slideId}) ---
    match /wrappedSlides/{slideId} {
      allow get: if isValidId(slideId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();

      allow create: if isAdmin()
        && isValidId(slideId)
        && isValidWrappedSlide(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(slideId)
        && isValidWrappedSlide(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'order', 'label', 'kind', 'theme', 'eyebrow', 'headline', 'body',
            'accentDate', 'metricPrefix', 'metricValue', 'metricSuffix',
            'secondaryMetricA', 'secondaryLabelA', 'secondaryMetricB', 'secondaryLabelB',
            'items', 'ctaLabel', 'published', 'updatedAt'
          ])
          ||
          incoming().diff(existing()).affectedKeys().hasOnly(['published', 'updatedAt'])
          ||
          incoming().diff(existing()).affectedKeys().hasOnly(['order', 'updatedAt'])
        );

      allow delete: if isAdmin() && isValidId(slideId);
    }
  }
}
